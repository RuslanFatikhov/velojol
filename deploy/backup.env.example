# Copy this file on the server to:
#   /opt/open-velojol/shared/backup.env
#
# Then set secure permissions:
#   chmod 600 /opt/open-velojol/shared/backup.env
#
# Recommended repository for Cloudflare R2:
#   RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket-name>

APP_ROOT=/opt/open-velojol
DB_PATH=/opt/open-velojol/current/instance/velojol.db
UPLOADS_DIR=/opt/open-velojol/current/app/static/uploads
LOCAL_BACKUP_DIR=/opt/open-velojol/backups/restic-staging

RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket-name>
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
AWS_DEFAULT_REGION=auto
AWS_REGION=auto
RESTIC_PASSWORD=<generate-a-long-random-password>

# Keep encrypted off-server backups.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Optional. Healthchecks.io URL, for example:
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
HEALTHCHECK_URL=

# Keep false unless you explicitly want encrypted backups to include app secrets.
BACKUP_INCLUDE_ENV=false
