[Unit]
Description=Velojol Gunicorn
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/open-velojol/current
Environment=APP_ENV=production
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/open-velojol/shared/.env
ExecStart=/opt/open-velojol/open-velojol-env/bin/gunicorn -w 2 -b 127.0.0.1:8020 run:app
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
