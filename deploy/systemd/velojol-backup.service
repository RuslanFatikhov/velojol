[Unit]
Description=Open Velojol encrypted off-server backup
After=network.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/open-velojol/current
Environment=APP_ROOT=/opt/open-velojol
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/open-velojol/shared/backup.env
ExecStart=/usr/local/bin/velojol-backup-restic.sh

# Keep backup runs from hanging forever if storage/network is unavailable.
TimeoutStartSec=2h
